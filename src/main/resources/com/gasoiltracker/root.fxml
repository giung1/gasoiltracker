<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="800.0" styleClass="root-view" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gasoiltracker.controller.RootController">
  <children>
    <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="500.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Main Title -->
            <Label layoutX="200.0" layoutY="30.0" styleClass="main-title" text="Estaciones de Servicio" />
            
            <!-- Subtitle -->
            <Label layoutX="280.0" layoutY="70.0" styleClass="subtitle" text="Seleccione o gestione sus estaciones de servicio" />
            
            <!-- Table Container -->
            <TableView fx:id="tblGasStations" layoutX="50.0" layoutY="120.0" prefHeight="280.0" prefWidth="700.0">
              <columns>
                <TableColumn fx:id="colGasStation" prefWidth="280.0" text="Nombre de la Estación" />
                <TableColumn fx:id="colLocality" prefWidth="280.0" text="Localidad" />
                <TableColumn fx:id="colLitros" prefWidth="140.0" text="Litros Actuales" />
              </columns>
            </TableView>
            
            <!-- Button Container -->
            <HBox layoutX="50.0" layoutY="420.0" spacing="20.0">
               <children>
                  <Button fx:id="selectGasStation" mnemonicParsing="false" onAction="#selectGasStation" prefHeight="40.0" prefWidth="150.0" styleClass="button, primary" text="Seleccionar" />
                  <Button fx:id="addGasStation" mnemonicParsing="false" onAction="#addGasStation" prefHeight="40.0" prefWidth="150.0" styleClass="button" text="Agregar Nueva" />
                  <Button mnemonicParsing="false" onAction="#deleteGasStation" prefHeight="40.0" prefWidth="150.0" styleClass="button, danger" text="Eliminar" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
    </AnchorPane>
  </children>
</VBox>
